# ==============================================================================
# BeforeSunrise Environment Configuration Template
# 복사하여 .env 파일로 이름을 바꾼 후 실제 키 값을 입력하세요.
# ==============================================================================

# 1. 한국투자증권 (KIS) Open API 계정
# KIS Developers (https://apiportal.koreainvestment.com/) 에서 발급받은 실전 계정 키
KIS_APP_KEY=your_kis_app_key_here
KIS_APP_SECRET=your_kis_app_secret_here

# 2. 텔레그램 봇 토큰 및 수신 채팅 ID
# @BotFather 에서 발급받은 봇 토큰 및 메시지를 수신할 텔레그램 Chat ID
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
